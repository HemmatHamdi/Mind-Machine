# Gemini API is opt-in. The default main:app never calls a model.
# Use a free-tier API key and keep billing/paid inference disabled.
# The Gemini adapter retrieves reviewed local FAQ passages before a model call.
# GEMINI_API_KEY must be supplied through the runtime secrets manager, not committed.
# Start the opt-in entrypoint only after separately approving a live model request:
GEMINI_EXECUTION_APPROVED=false
# Never commit a populated .env.
# Required local chat accounts: JSON mapping usernames to salted password hashes.
# Never store plaintext passwords here. Run:
#   .venv/bin/python create_chat_user.py --username your-user
# It prompts privately and updates only the untracked backend/.env, without
# printing passwords/hashes. Missing or invalid auth config disables /chat.
CHAT_AUTH_USERS=

# Per-authenticated-user sliding window, in one server process.
# Range: requests 1–10000; window 1–86400 seconds. Invalid settings fail closed.
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# GEMINI_API_KEY is secret; configure it in the runtime secrets manager.
