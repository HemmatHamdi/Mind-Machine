# Create a key at https://console.groq.com/keys. Never commit a populated .env.
# Verify the key's organization is on Free, not paid Developer, before using it.
GROQ_API_KEY=

# Explicit model ID. Recommended/test target: openai/gpt-oss-20b.
# No automatic model selection, provider routing, or paid fallback.
GROQ_MODEL=

# Fail-closed operator acknowledgement; not an automated billing-status check.
# Set to true ONLY after verifying the organization's Free plan in Groq Console.
GROQ_FREE_PLAN_CONFIRMED=false

# HTTPX network-operation timeout in seconds (1–120), not a total deadline.
GROQ_TIMEOUT_SECONDS=30

# Limit completion tokens per call (1–1024), including reasoning tokens.
GROQ_MAX_COMPLETION_TOKENS=512

# Required local chat accounts: JSON mapping usernames to salted password hashes.
# Never store plaintext passwords here. Run:
#   .venv/bin/python create_chat_user.py --username your-user
# It prompts privately and updates only the untracked backend/.env, without
# printing passwords/hashes. Missing or invalid auth config disables /chat.
CHAT_AUTH_USERS=

# Per-authenticated-user sliding window, in one server process.
# Range: requests 1–10000; window 1–86400 seconds. Invalid settings fail closed.
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
